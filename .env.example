# Скопіюй цей файл як .env і заповни значення

# Токен твого Telegram-бота (отримай від @BotFather)
BOT_TOKEN=1234567890:ABCDEFabcdefABCDEFabcdef1234567890

# Твій Telegram user ID (отримай від @userinfobot)
ADMIN_CHAT_ID=123456789

# Секретний пароль для адмін-панелі (придумай сам)
ADMIN_PASSWORD=mySuperSecretPassword123

# Supabase — URL та Service Role ключ твого проєкту
# Знайди в Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Порт сервера (Render підставить свій автоматично)
PORT=3000

# URL твого сайту на Render (заповни після деплою)
APP_URL=https://your-app-name.onrender.com
